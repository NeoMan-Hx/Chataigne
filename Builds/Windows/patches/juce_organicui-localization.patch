+float GlobalSettings::getGlobalUIScale()
+{
+	if (auto* settings = getInstanceWithoutCreating())
+		if (settings->interfaceScale != nullptr)
+			return jlimit(0.5f, 3.0f, settings->interfaceScale->intValue() / 100.0f);
+
+	return 1.0f;
+}
+
+void GlobalSettings::applyInterfaceScale()
+{
+	const float scale = getGlobalUIScale();
+	const auto apply = [scale]()
+	{
+		Desktop::getInstance().setGlobalScaleFactor(scale);
+		relayoutAndRepaintTopLevelWindows();
+	};
+
+	auto* mm = MessageManager::getInstanceWithoutCreating();
+	if (mm != nullptr && !mm->isThisTheMessageThread() && !mm->hasStopMessageBeenSent())
+		MessageManager::callAsync(apply);
+	else if (mm == nullptr || !mm->hasStopMessageBeenSent())
+		apply();
+}
+
+float GlobalSettings::getGlobalFontScale()
+{
+	if (auto* settings = getInstanceWithoutCreating())
+		if (settings->fontSize != nullptr)
+			return jlimit(0.5f, 3.0f, settings->fontSize->floatValue() / 14.0f);
+
+	return 1.0f;
+}
+
+float GlobalSettings::getUIFontSize(float baseSize)
+{
+	return jmax(0.1f, baseSize * getGlobalFontScale());
+}
