+	String selectedKey = ep->getValueKey();
+	for (int i = 0; i < buttons.size(); ++i)
+	{
+		if (i < ep->enumValues.size() && ep->enumValues[i] != nullptr)
+			buttons[i]->setToggleState(ep->enumValues[i]->key == selectedKey, dontSendNotification);
+	}
+}
+
+void EnumParameterButtonBarUI::buttonClicked(Button* b)
+{
+	int index = buttons.indexOf(dynamic_cast<TextButton*>(b));
+	if (index >= 0 && index < ep->enumValues.size() && ep->enumValues[index] != nullptr)
+		ep->setValueWithKey(ep->enumValues[index]->key);
+}
