diff --git a/settings/GlobalSettings.cpp b/settings/GlobalSettings.cpp
index d1bd1a7d..827bc465 100644
--- a/settings/GlobalSettings.cpp
+++ b/settings/GlobalSettings.cpp
@@ -19,6 +19,66 @@ namespace
 {
 using SafeComponent = Component::SafePointer<Component>;
 
+const juce::Identifier globalFontBaseHeightProperty("organicuiGlobalFontBaseHeight");
+
+void captureGlobalFontBase(Component& component)
+{
+	if (auto* label = dynamic_cast<Label*>(&component))
+	{
+		auto& properties = label->getProperties();
+		if (!properties.contains(globalFontBaseHeightProperty))
+			properties.set(globalFontBaseHeightProperty, label->getFont().getHeight());
+	}
+	else if (auto* editor = dynamic_cast<TextEditor*>(&component))
+	{
+		auto& properties = editor->getProperties();
+		if (!properties.contains(globalFontBaseHeightProperty))
+			properties.set(globalFontBaseHeightProperty, editor->getFont().getHeight());
+	}
+
+	for (int i = 0; i < component.getNumChildComponents(); ++i)
+		if (auto* child = component.getChildComponent(i)) captureGlobalFontBase(*child);
+}
+
+void applyGlobalFontToComponent(Component& component)
+{
+	if (auto* label = dynamic_cast<Label*>(&component))
+	{
+		auto& properties = label->getProperties();
+		if (!properties.contains(globalFontBaseHeightProperty))
+			properties.set(globalFontBaseHeightProperty, label->getFont().getHeight());
+
+		const float baseHeight = (float) properties[globalFontBaseHeightProperty];
+		label->setFont(label->getFont().withHeight(GlobalSettings::getUIFontSize(baseHeight)));
+	}
+	else if (auto* editor = dynamic_cast<TextEditor*>(&component))
+	{
+		auto& properties = editor->getProperties();
+		if (!properties.contains(globalFontBaseHeightProperty))
+			properties.set(globalFontBaseHeightProperty, editor->getFont().getHeight());
+
+		const float baseHeight = (float) properties[globalFontBaseHeightProperty];
+		editor->setFont(editor->getFont().withHeight(GlobalSettings::getUIFontSize(baseHeight)));
+	}
+}
+
+void applyGlobalFontToComponentTree(Component& component)
+{
+	SafeComponent safeComponent(&component);
+	applyGlobalFontToComponent(component);
+
+	if (safeComponent == nullptr) return;
+
+	std::vector<SafeComponent> children;
+	children.reserve((size_t)component.getNumChildComponents());
+
+	for (int i = 0; i < component.getNumChildComponents(); ++i)
