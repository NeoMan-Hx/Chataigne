+juce::Typeface::Ptr LookAndFeelOO::getTypefaceForFont(const juce::Font& font)
+{
+	// Always resolve the family through the base look-and-feel first.  The
+	// default sans-serif family is stored by LookAndFeel, not in the Font
+	// placeholder itself; creating a weighted typeface directly from that
+	// placeholder can select a Latin-only fallback and turn CJK glyphs into
+	// corrupted symbols.
+	const auto baseTypeface = juce::LookAndFeel_V4::getTypefaceForFont(font);
+	if (baseTypeface == nullptr) return baseTypeface;
+
+	if (auto* settings = GlobalSettings::getInstanceWithoutCreating())
+	{
+		// The selected weight is the global plain-text face. Explicit bold and
+		// italic styles continue to use the semantic JUCE styles requested by a
+		// control (for example, overridden parameters remain visibly bold).
+		if (settings->fontWeight != nullptr && font.getStyleFlags() == juce::Font::plain)
+		{
+			const auto selectedWeight = settings->fontWeight->getValueData().toString();
+			if (selectedWeight.isNotEmpty() && selectedWeight != "Regular")
+			{
+				auto weightedFont = font;
+				if (baseTypeface->getName().isNotEmpty())
+					weightedFont.setTypefaceName(baseTypeface->getName());
+				weightedFont.setTypefaceStyle(selectedWeight);
+				return juce::Typeface::createSystemTypefaceFor(weightedFont);
+			}
+		}
+	}
+
+	return baseTypeface;
+}
 
